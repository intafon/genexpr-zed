{
  "name": "genexpr-language-server",
  "version": "0.2.0",
  "private": true,
  "description": "Editor-independent GenExpr completion and documentation server",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "genexpr-language-server": "server/dist/genexpr-language-server.cjs" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs --server-only",
    "start": "node server/dist/genexpr-language-server.cjs --stdio",
    "test": "node --test server/test/*.test.js",
    "check:grammar": "node scripts/check-grammar.mjs",
    "check": "node scripts/check.mjs",
    "zed-settings": "node scripts/zed-settings.mjs"
  },
  "dependencies": {
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "tree-sitter-cli": "0.25.10"
  }
}
